# ─────────────────────────────────────────────────────────────────────────────
# NegotiatorAI — Environment Configuration
# Copy this file to .env and fill in your keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── PRIMARY: OpenRouter (recommended) ────────────────────────────────────────
# One key gives access to OpenAI, Anthropic, Google, Meta, Mistral and more.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── OPTIONAL: Direct provider keys ───────────────────────────────────────────
# Only needed if you want to call providers directly instead of via OpenRouter.
# Leave blank if you are using OpenRouter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── OPTIONAL: Tavily web search ───────────────────────────────────────────────
# Used as a fallback when the knowledge base has no strong match for a query.
# Get a free key at: https://tavily.com
TAVILY_API_KEY=

# ── Pipeline defaults (override via Streamlit sidebar at runtime) ─────────────
RAG_MODE=agentic_rag
# OpenRouter model identifier — see https://openrouter.ai/models for full list
# Recommended free/cheap options:
#   openai/gpt-4o-mini                 (fast, cheap, great quality)
#   meta-llama/llama-3.1-8b-instruct   (free tier on OpenRouter)
#   mistralai/mistral-7b-instruct      (free tier on OpenRouter)
LLM_MODEL=openai/gpt-4o-mini

# NOTE: Embeddings run locally via sentence-transformers — no API key needed.
# The model (~90 MB) is downloaded automatically on first run.
